# the symmetric-zero trap: x sin 2x on [-pi, pi] vanishes at the midpoint
# launch's every probe; the golden-section launch sees through it
abs(integral(fn x -> x * sin(2 * x), -pi, pi) + pi) < 1e-8
=> true
abs(integral(fn x -> x ^ 2, 0, 1) - 1 / 3) < 1e-10
=> true
abs(integral(fn x -> sin(x) ^ 2, 0, 2 * pi) - pi) < 1e-8
=> true
