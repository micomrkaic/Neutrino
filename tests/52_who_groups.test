# who's load groups: loaded files collapse to one shelf line; who("name")
# opens a shelf; "all" flattens; re-load replaces rather than duplicates.
# (each line is its own session: build the fixture with save() every time)
let solo9 = 41; save("/tmp/g52.nu"); clear(); load("/tmp/g52.nu"); who
=>   /tmp/g52.nu              1 names   (who("g52") to list)
let solo9 = 41; save("/tmp/g52.nu"); clear(); load("/tmp/g52.nu"); who("g52")
=>   solo9        int        = 41
let solo9 = 41; save("/tmp/g52.nu"); clear(); load("/tmp/g52.nu"); who("all")
=>   solo9        int        = 41
let solo9 = 41; save("/tmp/g52.nu"); clear(); load("/tmp/g52.nu"); load("/tmp/g52.nu"); who
=>   /tmp/g52.nu              1 names   (who("g52") to list)
