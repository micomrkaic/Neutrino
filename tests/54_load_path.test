=> 0.975002
load("poly"); "short name loads"
=> "short name loads"
load("packages/dist.nu"); norm.cdf(0, 0, 1)
=> 0.5
length(ls("packages"))
=> 9
load("astro.nu"); "ls-style names load"
=> "ls-style names load"
